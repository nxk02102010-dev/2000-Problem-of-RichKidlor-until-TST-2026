#include<bits/stdc++.h>
using namespace std;
/*
Idea:

*/
const int MAX = 200002;
int n,q;
vector<int> g[MAX];
int a[MAX],b[MAX];
long long S = 0;
long long operate = 0;
int times = 0;
int sz[MAX];
int dep[MAX];
int in[MAX];
int par[MAX];
int act[MAX];
struct Fenwick{
        int bit[MAX];
        void update(int i,int v){
                if(i)
                for(;i < MAX;i += i & -i) operate++,bit[i] += v;
        }
        int get(int i){
                int r = 0;
                for(;i > 0;i -= i & -i) operate++,r += bit[i];
                return r;
        }
} fenwick_mod;
struct Segment{
        pair<int,int> t[4 * MAX];
        void build(int v,int l,int r){
                if(l == r){
                        t[v] = {a[b[l]],l};
                        return;
                }
                int m = (l + r) >> 1;
                operate++;
                build(v << 1,l,m);
                operate++;
                build(v << 1 | 1,m + 1,r);
                t[v] = max(t[v << 1],t[v << 1 | 1]);
        }
        void update(int pos,int val,int v,int l,int r){
                if(l == r){
                        t[v] = {val,pos};
                        return;
                }
                int m = (l + r) >> 1;
                operate++;
                if(pos <= m) update(pos,val,v << 1,l,m);
                else update(pos,val,v << 1 | 1,m + 1,r);
                t[v] = max(t[v << 1],t[v << 1 | 1]);
        }
        pair<int,int> get(int tl,int tr,int v,int l,int r){
                if(r < tl || l > tr) return {0,0};
                if(tl <= l && r <= tr) return t[v];
                int m = (l + r) >> 1;
                if(m >= tr) {operate++;return get(tl,tr,v << 1,l,m);}
                if(m < tl) {operate++;return get(tl,tr,v << 1 | 1,m + 1,r);}
                operate++;
                operate++;
                return max(get(tl,tr,v << 1,l,m),get(tl,tr,v << 1 | 1,m + 1,r));
        }
} segment;
void update(int l,int r,int mod){
        if(l > r) swap(l,r);
        pair<int,int> mx = segment.get(l,r,1,1,n);
        while(mx.first >= mod){
                operate++;
                segment.update(mx.second,mx.first % mod,1,1,n);
                S += (mx.first % mod) - mx.first;
                fenwick_mod.update(mx.first,-1);
                fenwick_mod.update(mx.first % mod,1);
                mx = segment.get(l,r,1,1,n);
        }
}
int dfs(int u,int p){
        if(p != -1) g[u].erase(find(g[u].begin(),g[u].end(),p));
        sz[u] = 1;
        for(int &v : g[u]){
                operate++;
                par[v] = u;
                dep[v] = dep[u] + 1;
                sz[u] += dfs(v,u);
                if(sz[v] > sz[g[u][0]]) swap(v,g[u][0]);
        }
        return sz[u];
}
void dfs2(int u){
        in[u] = ++times;
        b[times] = u;
        if(u == 1) act[u] = u;
        for(int v : g[u]){
                act[v] = (v == g[u][0] ? act[u] : v);
                dfs2(v);
        }
}
void solve(){
        dfs(1,-1);
        dfs2(1);
        segment.build(1,1,n);
        for(int i = 1;i <= n;i++){
                fenwick_mod.update(a[i],1);
                S += a[i];
        }
        for(int i = 1;i <= q;i++){
                int l,r,mod;cin >> l >> r >> mod;
                while(act[l] != act[r]){
                        operate++;
                        if(dep[act[l]] < dep[act[r]]) swap(l,r);
                        update(in[act[l]],in[l],mod);
                        l = par[act[l]];
                }
                if(dep[l] > dep[r]) swap(l,r);
                update(in[l],in[r],mod);
                long long ans = S;
                for(int j = 1;i * j <= MAX - 2;j++){
                        operate++;
                        ans -= 1ll * (fenwick_mod.get(min(MAX - 2,i * (j + 1) - 1)) - fenwick_mod.get(i * j - 1)) * i * j;
                }
                cout << ans << '\n';
        }
        cerr << operate << '\n';
}
int main(){
        freopen("PINE.INP","r",stdin);
        freopen("PINE.OUT","w",stdout);
        ios::sync_with_stdio(0); cin.tie(0); cout.tie(0);
        cin >> n >> q;
        for(int i = 1;i <= n;i++) cin >> a[i];
        for(int i = 1;i <= n - 1;i++){
                int x,y;cin >> x >> y;
                g[x].push_back(y);
                g[y].push_back(x);
        }
        solve();
}
