#include<bits/stdc++.h>
using namespace std;
/*
Idea:

*/
const int MAX = 200100;
int n,q;
long long a[MAX];
int eli[MAX];
long long ans[MAX];
multiset<long long> st;
long long C(long long n){
        return n * (n - 1) / 2;
}
struct DSU{
        int p[MAX];
        map<long long,long long> cnt[MAX];
        long long cur[MAX];
        long long res[MAX];
        int sz[MAX];
        void init(int n){
                iota(p,p + n + 1,0);
                fill(sz,sz + n + 1,1);
                for(int i = 1;i <= n;i++) cnt[i][a[i]]++,st.insert(0);
        }
        int par(int v){ return v == p[v] ? v : p[v] = par(p[v]); }
        bool unite(int a,int b){
                a = par(a);
                b = par(b);
                if(a == b) {
                        return 0;
                }
                if(sz[a] < sz[b]) swap(a,b);
                st.erase(st.find(res[a]));
                st.erase(st.find(res[b]));
                p[b] = a;
                sz[a] += sz[b];
                for(auto &v : cnt[b]){
                        cur[a] -= C(cnt[a][v.first]);
                        cnt[a][v.first] += v.second;
                        cur[a] += C(cnt[a][v.first]);
                }
                res[a] = C(sz[a]) - cur[a];
                st.insert(res[a]);
                return 1;
        }
} dsu;
int main(){
        freopen("TET.INP","r",stdin);
        freopen("TET.OUT","w",stdout);
        ios::sync_with_stdio(0); cin.tie(0); cout.tie(0);
        cin >> n >> q;
        vector<int> qual(n + 1);
        for(int i = 1;i <= n;i++){
                cin >> a[i];
        }
        dsu.init(n);
        for(int i = 1;i <= q;i++){
                cin >> eli[i];
                qual[eli[i]]++;
        }
        for(int i = 1;i < n;i++) if(!qual[i] && !qual[i + 1]){
                dsu.unite(i,i + 1);
        }
        for(int i = q;i >= 1;i--){
                qual[eli[i]]--;
                ans[i] = (*st.rbegin());
                if(qual[eli[i]] == 0){
                        if(eli[i] < n && !qual[eli[i] + 1]) dsu.unite(eli[i],eli[i] + 1);
                        if(eli[i] > 1 && !qual[eli[i] - 1]) dsu.unite(eli[i],eli[i] - 1);
                }
        }
        for(int i = 1;i <= q;i++) cout << ans[i] + 1 << '\n';
}
