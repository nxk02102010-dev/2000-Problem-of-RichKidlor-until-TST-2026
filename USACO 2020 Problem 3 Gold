Problem 3. Springboards

#include<bits/stdc++.h>
using namespace std;
/*
Idea:

*/
const int MAX = 500100;
const long long MAXPOS = 1e18;
array<long long,4> a[MAX];
int n,p;
namespace sub1{
        bool check(){
                return p <= 1000;
        }
        void solve(){
                sort(a + 1,a + p + 1);
                long long ans[MAX];
                fill(ans,ans + p + 1,MAXPOS);
                for(int i = 1;i <= p;i++){
                        ans[i] = min(ans[i],a[i][0] + a[i][1]);
                        for(int j = 1;j < i;j++){
                                if(a[j][2] <= a[i][0] && a[j][3] <= a[i][1]){
                                        ans[i] = min(ans[i],ans[j] + a[i][0] - a[j][2] + a[i][1] - a[j][3]);
                                }
                        }
                }
//                for(int i = 1;i <= p;i++) cout << ans[i] << ' ';
//                cout << '\n';
                long long res = n + n;
                for(int i = 1;i <= p;i++){
                        res = min(res,ans[i] + abs(a[i][2] - n) + abs(a[i][3] - n));
                }
                cout << res << '\n';
                exit(0);
        }
}
namespace fullsolve{
        long long t[4 * MAX];
        int sz = 0;
        void up(int pos,long long val,int v = 1,int l = 1,int r = sz){
                if(l == r){
                        t[v] = min(t[v],val);
                        return ;
                }
                int m = (l + r) >> 1;
                if(pos <= m) up(pos,val,v << 1,l,m);
                else up(pos,val,v << 1 | 1,m + 1,r);
                t[v] = min(t[v << 1],t[v << 1 | 1]);
        }
        long long get(int tl,int tr,int v = 1,int l = 1,int r = sz){
                if(l > tr || r < tl) return MAXPOS;
                if(l >= tl && r <= tr) return t[v];
                int m = (l + r) >> 1;
                return min(get(tl,tr,v << 1,l,m),get(tl,tr,v << 1 | 1,m + 1,r));
        }
        void solve(){
                long long ans[MAX];
                vector<long long> vals;
                vector<array<long long,4>> events;
                fill(t,t + 4 * MAX,MAXPOS);
                fill(ans,ans + MAX,MAXPOS);
                sort(a + 1, a + p + 1, [&](auto &a, auto &b){
                        if(a[0] != b[0]) return a[0] < b[0];
                        if(a[1] != b[1]) return a[1] < b[1];
                        return a[3] < b[3];
                });
                //vals.push_back(0);
                for(int i= 1;i <= p;i++){
                        ans[i] = a[i][0] + a[i][1];
                        vals.push_back(a[i][0]);
                        vals.push_back(a[i][2]);
                        events.push_back({a[i][1],a[i][0],1,i});
                        events.push_back({a[i][3],a[i][2],0,i});
                }
                sort(vals.begin(),vals.end());
                vals.erase(unique(vals.begin(),vals.end()),vals.end());
                sz = vals.size();
                auto id = [&](long long x) -> int{
                        return (int)(lower_bound(vals.begin(),vals.end(),x) - vals.begin()) + 1;
                };
                sort(events.begin(),events.end(),[&](const array<long long,4> &x,const array<long long,4> &y){
                        if(x[0] != y[0]) return x[0] < y[0];
                        if(x[1] != y[1]) return x[1] < y[1];
                        if(x[2] != y[2]) return x[2] < y[2];
                        return x[3] < y[3];
                });
                //up(id(0),0);
                for(auto &ii : events){
                        long long y = ii[0];
                        long long x = ii[1];
                        int s = ii[2];
                        int i = ii[3];
                        if(s){
                                long long nxt = get(1,id(x)) + x + y;
                                //if(nxt >= 0)
                                ans[i] = min(ans[i],nxt);
                        }
                        else{
                                up(id(x),ans[i] - x - y);
                        }
                }
                long long res = MAXPOS;
                for(int i = 1;i <= p;i++){
                        //if(ans[i] + n - a[i][2] + n - a[i][3] >= 0)
                        res = min(res,ans[i] + n - a[i][2] + n - a[i][3]);
                }
                cout << res << '\n';
        }
}
int main(){
        freopen("boards.in","r",stdin);
        freopen("boards.out","w",stdout);
        ios::sync_with_stdio(0); cin.tie(0); cout.tie(0);
        cin >> n >> p;
        for(int i = 1;i <= p;i++){
                cin >> a[i][0];
                cin >> a[i][1];
                cin >> a[i][2];
                cin >> a[i][3];
        }
        if(sub1::check()) sub1::solve();
        fullsolve::solve();
}
