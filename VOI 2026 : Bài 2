#include<bits/stdc++.h>
using namespace std;
/*
Idea:

*/
const int MAX = 300100;
const long long INF = 1e9;
int n,q;
struct El{
        long long s,w;
} a[MAX];
int toW[MAX];
int W[MAX];
int S[MAX];
vector<long long> vals;
long long M[MAX],K[MAX],T[MAX];
long long ans[MAX];
struct Fenwick{
        long long bit[MAX];
        void up(int i,long long v){
                for(;i <= n;i += i & -i) bit[i] += v;
        }
        long long get(int i){
                long long r = 0;
                for(;i > 0;i -= i & -i) r += bit[i];
                return r;
        }
} bitS,bitW,bitOff,bitWOff;
long long get_ans(long long need,long long T){
        int i = 0;
        long long w = 0;
        for(int j = 19;j >= 0;j--) if(i + (1 << j) <= n){
                int nxt = i + (1 << j);
                long long totS = bitS.bit[nxt] + bitOff.bit[nxt] * T;
                if(totS <= need){
                        need -= totS;
                        w += bitW.bit[nxt] + bitWOff.bit[nxt] * T;
                        i = nxt;
                }
        }
        return w + need * a[W[i + 1]].w;
}
int check(long long M,long long K,long long T){
        if(bitS.get(n) + bitOff.get(n) * T < K * T) return 0;
        return get_ans(K * T,T) <= M;
}
void PBS(long long l,long long r,vector<int> &vi){
        if(vi.empty()) return;
        if(l == r){
                for(int &v : vi) ans[v] = l;
                return;
        }
        long long m = (l + r) >> 1;
        int pl = lower_bound(vals.begin(),vals.end(),l) - vals.begin();
        int pm = upper_bound(vals.begin(),vals.end(),m) - vals.begin() - 1;
        int pr = upper_bound(vals.begin(),vals.end(),m + 1) - vals.begin() - 1;
        for(int i = pl;i <= pr;i++){
                bitS.up(toW[S[i]],vals[i]);
                bitW.up(toW[S[i]],vals[i] * a[S[i]].w);
                bitOff.up(toW[S[i]],-1);
                bitWOff.up(toW[S[i]],-a[S[i]].w);
        }
        vector<int> vl,vr;
        for(int &v : vi) {if(check(M[v],K[v],m + 1)) vr.push_back(v); else vl.push_back(v);}
        for(int i = pm + 1;i <= pr;i++){
                bitS.up(toW[S[i]],-vals[i]);
                bitW.up(toW[S[i]],-vals[i] * a[S[i]].w);
                bitOff.up(toW[S[i]],1);
                bitWOff.up(toW[S[i]],a[S[i]].w);
        }
        PBS(m + 1,r,vr);
        for(int i = pl;i <= pm;i++){
                bitS.up(toW[S[i]],-vals[i]);
                bitW.up(toW[S[i]],-vals[i] * a[S[i]].w);
                bitOff.up(toW[S[i]],1);
                bitWOff.up(toW[S[i]],a[S[i]].w);
        }
        PBS(l,m,vl);
}
void solve(vector<int> &vi){
        if(vi.empty()) return;
        sort(vi.begin(),vi.end(),[&](const int &x,const int &y){ return T[x] < T[y]; });
        int i = 1;
        for(int &v : vi){
                while(i < (int)vals.size() && vals[i] <= T[v]){
                        bitS.up(toW[S[i]],vals[i]);
                        bitW.up(toW[S[i]],vals[i] * a[S[i]].w);
                        bitOff.up(toW[S[i]],-1);
                        bitWOff.up(toW[S[i]],-a[S[i]].w);
                        i++;
                }
                ans[v] = check(M[v],K[v],T[v]);
        }
}
int main(){
        freopen("GIFT.INP","r",stdin);
        freopen("GIFT.OUT","w",stdout);
        ios::sync_with_stdio(0); cin.tie(0); cout.tie(0);
        cin >> n >> q;
        for(int i = 1;i <= n;i++) cin >> a[i].w;
        for(int i = 1;i <= n;i++) cin >> a[i].s,vals.push_back(a[i].s);
        vals.push_back(-INF);
        sort(vals.begin(),vals.end());
        iota(toW,toW + n + 1,0);
        iota(W,W + n + 1,0);
        iota(S,S + n + 1,0);
        sort(W + 1,W + n + 1,[&](const int &x,const int &b){ return a[x].w < a[b].w; });
        sort(S + 1,S + n + 1,[&](const int &x,const int &b){ return a[x].s < a[b].s; });
        for(int i = 1;i <= n;i++){
                toW[W[i]] = i;
        }
        vector<int> v1,v2;
        for(int i = 1;i <= q;i++){
                int t;cin >> t;
                cin >> M[i] >> K[i];
                if(t == 1){
                        cin >> T[i];
                        v1.push_back(i);
                }
                else{
                        v2.push_back(i);
                }
        }
        for(int i = 1;i <= n;i++){
                bitOff.up(i,1);
                bitWOff.up(i,a[W[i]].w);
        }
        PBS(0,INF,v2);
        solve(v1);
        for(int i = 1;i <= q;i++) cout << ans[i] << '\n';
}
