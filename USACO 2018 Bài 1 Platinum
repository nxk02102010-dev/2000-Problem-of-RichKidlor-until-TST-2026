USACO 2018 February Contest, Platinum
Problem 1. Slingshot

#include<bits/stdc++.h>
using namespace std;
/*
Idea:
|a - x| + t + |b - y|
có vài trường hợp

x - a và y - b
ans = t + x + y

a - x và y - b
ans = t - x + y

a - x và b - y


x - a và b - y

*/
const int MAX = 4e5 + 1;
const long long INF = 1e18;
int n,q;
struct P{
        int type;
        long long x,y;
        long long t;
        int i;
} a[MAX], b[MAX];
struct Segment{
        vector<long long> t;
        Segment(int _sz){
                t.assign(4 * _sz + 5, INF);
        }
        void up(int pos,long long val,int v,int l,int r){
                if(l == r){
                        t[v] = min(t[v], val);
                        return;
                }
                int m = (l + r) >> 1;
                if(pos <= m) up(pos,val,v << 1,l,m);
                else up(pos,val,v << 1 | 1,m + 1,r);
                t[v] = min(t[v << 1],t[v << 1 | 1]);
        }
        long long get(int tl,int tr,int v,int l,int r){
                if(l > tr || r < tl) return INF;
                if(l >= tl && r<= tr) return t[v];
                int m = (l + r) >> 1;
                return min(get(tl,tr,v << 1,l,m),get(tl,tr,v << 1 | 1,m + 1,r));
        }
};
int main(){
        freopen("slingshot.in","r",stdin);
        freopen("slingshot.out","w",stdout);
        ios::sync_with_stdio(0); cin.tie(0); cout.tie(0);
        cin >> n >> q;
        vector<long long> vals;
        vector<P> events;
        for(int i = 1;i <= n;i++){
                cin >> a[i].x >> a[i].y >> a[i].t;
                a[i].i = i;
                //if(a[i].x > a[i].y) swap(a[i].x,a[i].y);
                a[i].type = 0;
                events.push_back(a[i]);
                vals.push_back(a[i].x);
                vals.push_back(a[i].y);
        }
        for(int i = 1;i <= q;i++){
                cin >> b[i].x >> b[i].y;
                b[i].i = i;
                //if(b[i].x > b[i].y) swap(b[i].x,b[i].y);
                b[i].type = 1;
                events.push_back(b[i]);
                vals.push_back(b[i].x);
                vals.push_back(b[i].y);
        }
        sort(vals.begin(),vals.end());
        vals.erase(unique(vals.begin(),vals.end()),vals.end());
        auto id = [&](long long x) -> int{
                return (int)(lower_bound(vals.begin(),vals.end(),x) - vals.begin()) + 1;
        };
        sort(events.begin(),events.end() ,[&](const P &a,const P &b){
                if(a.x != b.x) return a.x < b.x;
                return a.type < b.type;
        });
        int sz = vals.size();
        static Segment xayb(sz);
        static Segment axyb(sz);
        static Segment xaby(sz);
        static Segment axby(sz);
        long long ans[MAX];
        for(auto &i : events){
                if(i.type == 0){
                        int idd = id(i.y);
                        //xayb.up(idd,i.t + i.y + i.x,1,1,sz);
                        axyb.up(idd,i.t + i.y - i.x,1,1,sz);
                        //xaby.up(idd,i.t - i.y + i.x,1,1,sz);
                        axby.up(idd,i.t - i.y - i.x,1,1,sz);
                }
                else{
                        int idd = id(i.y);
                        ans[i.i] = abs(i.y - i.x);
                        ans[i.i] = min({ans[i.i], i.x - i.y +  axyb.get(idd,sz,1,1,sz),i.x + i.y + axby.get(1,idd,1,1,sz) });
                }
        }
        sort(events.begin(),events.end() ,[&](const P &a,const P &b){
                if(a.x != b.x) return a.x > b.x;
                return a.type < b.type;
        });
        for(auto &i : events){
                if(i.type == 0){
                        int idd = id(i.y);
                        xayb.up(idd,i.t + i.y + i.x,1,1,sz);
                        //axyb.up(idd,i.t + i.y - i.x,1,1,sz);
                        xaby.up(idd,i.t - i.y + i.x,1,1,sz);
                        //axby.up(idd,i.t - i.y - i.x,1,1,sz);
                }
                else{
                        int idd = id(i.y);
                        ans[i.i] = min({ ans[i.i], -i.x - i.y +  xayb.get(idd,sz,1,1,sz),-i.x + i.y + xaby.get(1,idd,1,1,sz) });
                }
        }
        for(int i = 1;i <= q;i++) cout << ans[i] << '\n';
}
